# Database configuration
# Primary default is local MySQL 8 (matching docker-compose.yml):
DB_URL=mysql+pymysql://regression_user:regression_pass@localhost:3306/regression_db
# Automatic SQLite fallback if MySQL is unreachable:
# DB_URL=sqlite:///regression_manager.db

# Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
JUDGE_MODEL=gemma2:2b

# Regression Runner defaults
DEFAULT_REPEATS=5
DEFAULT_TEMPERATURE=0.7
REGRESSION_THRESHOLD=0.10
STAT_SIGNIFICANCE_ALPHA=0.05

